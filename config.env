# ClickHouse illumos build configuration.
#
# The parent-repo patches live as commits on the `smartos/<line>` branch of
# the fork (github.com/TritonDataCenter/ClickHouse). The handful of patches that
# touch files *inside* submodules (libcxx, abseil, datasketches, miniselect,
# s2geometry, ...) cannot live on a superproject branch, so they stay here as
# plain diffs in patches/ and are applied at build time after
# `git submodule update`.
#
# To bump to a new ClickHouse release:
#   1. In a ClickHouse checkout:  git checkout -b smartos/<new> v<new>-lts
#                                 git submodule update --init --recursive --depth 1
#                                 git rebase --onto v<new>-lts v<old>-lts smartos/<old>
#      resolve conflicts, then `git push origin smartos/<new>`.
#   2. Re-roll the submodule diffs (fix conflicts by hand in the submodule
#      worktrees, then `./extract-submodule-patches.sh`).
#   3. Update CH_REF / CH_VER below and run ./build.sh.

# Fork + branch carrying the parent-repo illumos patches. https so the CI
# builder clones the public repo without needing an ssh key on the zone.
CH_REPO="https://github.com/TritonDataCenter/ClickHouse.git"
CH_REF="smartos/26.3"
# Marketing version of the release this branch is based on (for artifact name).
CH_VER="26.3.10.60"
# Working checkout location on the build host.
CH_SRC="/opt/ClickHouse"

# Upstream remote, added so you can fetch new release tags for rebasing.
CH_UPSTREAM="https://github.com/ClickHouse/ClickHouse.git"

# Install prefix baked into the binary (rpath, default config search).
CH_PREFIX="/opt/clickhouse"

# pkgsrc toolchain on SmartOS (needs pkgsrc *trunk*: clang>=21, gcc13>=13.4,
# lld, cmake>=4). Override if your install differs.
PKGSRC_PREFIX="/opt/local"
CLANG="${PKGSRC_PREFIX}/bin/clang"
CLANGXX="${PKGSRC_PREFIX}/bin/clang++"

# Keep retrying with fewer ninja jobs after a parallel pass fails (recovers
# from transient memory pressure during link).
CH_LINK_RECOVERY=1
